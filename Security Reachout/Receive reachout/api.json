{
  "post": {
    "summary": "Start a security reachout",
    "description": "Validates the request, records an open reachout, and returns immediately. The Slack DM, answer handling, and Tines case updates happen asynchronously.",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["correlation_id", "case_id", "case_url", "user_upn", "question", "alert_title", "slack_channel", "slack_thread_ts"],
            "properties": {
              "correlation_id": { "type": "string" },
              "case_id": { "type": ["string", "integer"] },
              "case_url": { "type": "string", "format": "uri" },
              "user_upn": { "type": "string", "format": "email" },
              "question": { "type": "string" },
              "alert_title": { "type": "string" },
              "slack_channel": { "type": "string", "description": "Slack channel ID" },
              "slack_thread_ts": { "type": "string" },
              "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 10080, "default": 60 }
            }
          }
        }
      }
    },
    "responses": {
      "202": { "description": "Accepted", "content": { "application/json": { "schema": { "type": "object", "properties": { "reachout_id": { "type": "string", "format": "uuid" } } } } } },
      "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" }, "details": { "type": "array", "items": { "type": "string" } } } } } } }
    }
  }
}
